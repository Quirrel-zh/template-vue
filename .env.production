# ============================================
# 生产环境配置
# 打包时使用 pnpm build
# ============================================
# 注意：所有以 VITE_ 开头的变量会被暴露到客户端代码中
# 不要在此文件中存储敏感信息（如密钥、密码等）
# ============================================

# API 基础 URL
# 生产环境使用 /api 前缀，与开发环境保持一致
# nginx 会将 /api 请求代理到后端服务
VITE_API_BASE_URL=/api
