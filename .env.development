# ============================================
# 开发环境配置
# pnpm dev
# ============================================
# 注意：所有以 VITE_ 开头的变量会被暴露到客户端代码中
# 不要在此文件中存储敏感信息（如密钥、密码等）
# ============================================

# API 基础 URL
# 开发环境: /api (使用 Vite 代理)
# 测试环境:
# 生产环境:
VITE_API_BASE_URL=/api

# Vite 开发服务器代理目标（仅开发环境使用）
# 如果 VITE_API_BASE_URL 设置为 /api，则此配置生效
VITE_PROXY_TARGET=
